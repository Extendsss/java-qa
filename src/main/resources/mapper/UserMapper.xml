<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quiz.mapper.UserMapper">
  <select id="findById" resultType="com.quiz.entity.SysUser">SELECT * FROM sys_user WHERE id=#{id}</select>
  <select id="findByUsername" resultType="com.quiz.entity.SysUser">SELECT * FROM sys_user WHERE username=#{username}</select>
  <sql id="filter"><if test="keyword != null and keyword != ''"> WHERE username LIKE CONCAT('%',#{keyword},'%')</if></sql>
  <select id="findPage" resultType="com.quiz.entity.SysUser">SELECT * FROM sys_user <include refid="filter"/> ORDER BY id DESC LIMIT #{offset},#{size}</select>
  <select id="count" resultType="long">SELECT COUNT(*) FROM sys_user <include refid="filter"/></select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO sys_user(username,password,nickname,role,status) VALUES(#{username},#{password},#{nickname},#{role},#{status})</insert>
  <update id="update">UPDATE sys_user SET nickname=#{nickname},role=#{role},status=#{status} WHERE id=#{id}</update>
  <update id="updatePassword">UPDATE sys_user SET password=#{password} WHERE id=#{id}</update>
</mapper>
