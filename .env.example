# PowerShell 中通过 $env:DB_USERNAME='root' 等设置；Spring Boot 不会自动读取 .env 文件。
DB_URL=jdbc:mysql://localhost:3306/quiz_system?createDatabaseIfNotExist=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
